{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/about.json: el about",
  "description": "data/about.json: el panel de \"Miranda Pérez-Hita\". Sus fotos, en data/about/. VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "$defs": {
    "photo": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "El número de la foto, entre comillas y sin .webp: \"3\" es img/3.webp"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "photo",
            "size"
          ],
          "description": "Una foto más pequeña: { \"photo\": \"3\", \"size\": 80 }",
          "properties": {
            "photo": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "El número de la foto: \"3\""
            },
            "size": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "description": "El tamaño, del 1 al 100 (100 es el normal), sin comillas."
            }
          }
        }
      ]
    }
  },
  "required": [
    "text",
    "photos"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ca"
      ],
      "description": "El texto. **negrita**, *cursiva*, __subrayado__ y [un enlace](https://…).",
      "properties": {
        "ca": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "En catalán, un párrafo por línea."
        },
        "es": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "En castellano. Si falta, sale el catalán."
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/photo"
      },
      "description": "Las fotos de data/about/, en orden: [\"1\"]"
    }
  }
}
