# macOS
.DS_Store

# Herramientas locales de Claude Code. Se ignora todo lo de la carpeta menos el
# servidor de previsualización y su configuración, que sí interesa versionar: son
# la manera de levantar el sitio en local sin depender de nada más.
# El patrón tiene que ser .claude/* y no .claude/: con la barra final git no
# entra en la carpeta y las excepciones de abajo no se aplicarían.
.claude/*
!.claude/launch.json
!.claude/serve.js

# Node (el sitio no tiene dependencias, pero por si acaso)
node_modules/

# La web generada: la escribe node build/build.mjs y la publica la Action
dist/
# Las imágenes para compartir (sharp): las hace el build
.cache/
